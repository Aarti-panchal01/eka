# ============================================================================
# EKA — environment template.  Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------- app
ENVIRONMENT=local                 # local | docker | render | production
DEBUG=true
SECRET_KEY=generate_64_random_chars_here
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*                    # comma-separated list, or * for all

# ---------------------------------------------------------------------- LLM
# groq     -> Groq free API with base Llama. Works day one, zero infra.
# ollama   -> your merged fine-tuned personas (local, or via `ngrok http 11434`)
# hf_space -> a Hugging Face Space (ZeroGPU) serving the merged model
LLM_MODE=groq

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant           # user-facing generation
GROQ_GEN_MODEL=llama-3.3-70b-versatile    # offline data generation only

# Used when LLM_MODE=ollama. With ngrok: https://xxxx-xx.ngrok-free.app
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_PREFIX=eka                   # -> eka-founder, eka-chanakya, ...

# Used when LLM_MODE=hf_space
HF_SPACE_URL=

# ------------------------------------------------------------ hugging face
HF_TOKEN=hf_your_token_here
HF_USERNAME=your-hf-username              # REQUIRED: all model repos hang off this

# ----------------------------------------------------------------- database
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Direct connection (port 5432):
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
# Pooled connection (port 6543) also works — config.py disables prepared
# statements automatically when it sees a pooler URL.

# ---------------------------------------------------------------- vector db
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here
QDRANT_COLLECTION=memories
EMBEDDING_DIM=768

# -------------------------------------------------------------------- voice
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_TTS_MODEL=bulbul:v2
# Swap any of these freely — no code change needed.
# Valid speakers (from the API's own error response, which is more current than
# the docs): anushka abhilash manisha vidya arya karun hitesh aditya ritu priya
# neha rahul pooja rohan simran kavya amit dev ishita shreya ratan varun manan
# sumit roopa kabir aayan shubh ashutosh advait anand tanya tarun sunny mani
# gokul vijay shruti suhani mohit kavitha rehan soham rupali
# To re-check the list at any time, POST to Sarvam TTS with speaker="xxx" and
# read the 400 response. The old v1 names (arvind, amol, maya) are gone.
SARVAM_VOICE_FOUNDER=karun
SARVAM_VOICE_CHANAKYA=abhilash
SARVAM_VOICE_GITA=anushka
SARVAM_VOICE_REFLECTION=vidya

# ------------------------------------------------------- classifier serving
# Leave EMPTY to run the classifiers in-process (Render single-service setup).
# Set to a URL only if you run serving/*_serve.py as separate processes.
COMPLEXITY_SERVE_URL=
RANKER_SERVE_URL=
SENTIMENT_SERVE_URL=
ENABLE_LOCAL_CLASSIFIERS=true

# -------------------------------------------------------------------- wandb
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=eka

# ------------------------------------------------------- docker-compose only
DB_PASSWORD=eka_local_password
