# ---- ml artifacts (big; live on HF Hub instead) ------------------------
ml/models/
ml/data/raw/
ml/data/processed/
ml/data/splits/
!ml/models/.gitkeep
!ml/data/raw/.gitkeep
*.safetensors
*.bin
*.gguf
*.ckpt
wandb/

# Generated datasets are large but reproducible — keep them out of git and
# push them to the HF Hub dataset repo instead (ml/scripts/upload_to_hf.py).
ml/datasets/*.json
ml/datasets/*.jsonl
!ml/datasets/.gitkeep

