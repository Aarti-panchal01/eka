# Eka frontend environment variables
#
# Vite only exposes environment variables to browser code if their name is
# prefixed with VITE_ — anything else (e.g. plain EKA_API_URL) is invisible
# to import.meta.env and silently undefined at runtime. Keep the prefix.
#
# IMPORTANT: Vite inlines these values at BUILD time, not at server start.
# If you change this value in .env, you must rebuild (and, for a deployed
# site, redeploy) the frontend for the new value to take effect — restarting
# a dev server picks it up, but a production build/preview will not until
# it's rebuilt.
#
# Copy this file to .env (or .env.local) and edit as needed:
#   cp .env.example .env

# --- Local backend (uvicorn running on your machine) ---
VITE_EKA_API_URL=http://localhost:8000

# --- Deployed backend (Render) ---
# Replace with your actual Render service URL. Render free-tier services
# spin down when idle, so the first request after a period of inactivity
# can take 30-60 seconds to wake up — see MIGRATION_NOTES.md for how the
# client should handle that.
# VITE_EKA_API_URL=https://eka-backend.onrender.com
