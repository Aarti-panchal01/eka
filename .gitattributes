# This repo is developed on Windows with core.autocrlf=true, which rewrites
# checked-out files to CRLF. For shell scripts that is not cosmetic: bash reads
# the trailing \r as part of the command and a fresh clone fails with
# `$'\r': command not found` on the very first line. Pin them to LF.
*.sh text eol=lf

# Same reasoning for anything else executed by a POSIX interpreter or parsed
# strictly, rather than read by a human.
Makefile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Notebooks are JSON — generated by scripts/build_kaggle_notebooks.py and
# compared byte-for-byte by its --check mode. CRLF would make --check report
# every notebook as stale on a fresh clone.
*.ipynb text eol=lf

*.py text eol=lf
*.md text eol=lf
